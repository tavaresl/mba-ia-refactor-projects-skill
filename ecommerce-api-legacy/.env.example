# Porta HTTP (padrão: 3000)
PORT=3000

# Chave do gateway de pagamento (não versionar o valor real)
PAYMENT_GATEWAY_KEY=

# Token das rotas administrativas (GET /api/admin/financial-report e DELETE /api/users/:id).
# Enviado no header X-Admin-Token. Se ficar vazio, essas rotas respondem 403.
ADMIN_TOKEN=

# Nível de log: debug | info | warn | error (padrão: info)
LOG_LEVEL=info
