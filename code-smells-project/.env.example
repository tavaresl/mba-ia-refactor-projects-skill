# Copie para .env / exporte as variáveis no ambiente. Nenhum valor real aqui.
# Chave da aplicação. Se ausente, uma chave aleatória é gerada a cada boot.
SECRET_KEY=
# Debug do Flask (padrão: false). Nunca ligue em produção.
DEBUG=false
HOST=0.0.0.0
PORT=5000
# Caminho do SQLite (relativo à pasta do projeto ou absoluto)
DB_PATH=loja.db
# Valor exibido em /health como "ambiente"
APP_ENV=producao
# Token dos endpoints /admin/* (header X-Admin-Token). Vazio = endpoints desligados (403).
ADMIN_TOKEN=
