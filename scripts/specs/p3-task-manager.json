{
  "name": "task-manager-api",
  "description": "API de Task Manager (Python/Flask + SQLAlchemy). Banco SQLite recriado e populado pelo seed a cada execução.",
  "cwd": "task-manager-api",
  "port": 5002,
  "setup": ["rm -f tasks.db instance/tasks.db", ".venv/bin/python seed.py"],
  "start": ".venv/bin/flask --app app run --port {port}",
  "ready_path": "/",
  "requests": [
    {"label": "Index", "method": "GET", "path": "/", "expect": 200},
    {"label": "Health check", "method": "GET", "path": "/health", "expect": 200},

    {"label": "Listar tasks", "method": "GET", "path": "/tasks", "expect": 200},
    {"label": "Buscar task existente", "method": "GET", "path": "/tasks/1", "expect": 200},
    {"label": "Buscar task inexistente", "method": "GET", "path": "/tasks/9999", "expect": 404},
    {"label": "Pesquisar tasks por texto", "method": "GET", "path": "/tasks/search?q=API", "expect": 200},
    {"label": "Pesquisar tasks por status e prioridade", "method": "GET", "path": "/tasks/search?status=pending&priority=1", "expect": 200},
    {"label": "Estatísticas de tasks", "method": "GET", "path": "/tasks/stats", "expect": 200},
    {"label": "Criar task", "method": "POST", "path": "/tasks",
     "body": {"title": "Task do smoke test", "description": "Criada pelo smoke test", "priority": 2, "user_id": 1, "category_id": 1, "due_date": "2030-01-15", "tags": ["smoke", "teste"]},
     "expect": 201, "save": {"task_id": "id"}},
    {"label": "Criar task com título curto", "method": "POST", "path": "/tasks",
     "body": {"title": "ab"}, "expect": 400},
    {"label": "Criar task com usuário inexistente", "method": "POST", "path": "/tasks",
     "body": {"title": "Task inválida", "user_id": 9999}, "expect": 404},
    {"label": "Atualizar task", "method": "PUT", "path": "/tasks/{task_id}",
     "body": {"status": "in_progress", "priority": 1}, "expect": 200},
    {"label": "Atualizar task com status inválido", "method": "PUT", "path": "/tasks/{task_id}",
     "body": {"status": "invalido"}, "expect": 400},
    {"label": "Atualizar task inexistente", "method": "PUT", "path": "/tasks/9999",
     "body": {"status": "done"}, "expect": 404},

    {"label": "Listar usuários", "method": "GET", "path": "/users", "expect": 200},
    {"label": "Buscar usuário existente", "method": "GET", "path": "/users/1", "expect": 200},
    {"label": "Buscar usuário inexistente", "method": "GET", "path": "/users/9999", "expect": 404},
    {"label": "Criar usuário", "method": "POST", "path": "/users",
     "body": {"name": "Smoke User", "email": "smoke@teste.com", "password": "smoke123", "role": "user"},
     "expect": 201, "save": {"user_id": "id"}},
    {"label": "Criar usuário com email duplicado", "method": "POST", "path": "/users",
     "body": {"name": "Smoke User 2", "email": "smoke@teste.com", "password": "smoke123"}, "expect": 409},
    {"label": "Criar usuário com email inválido", "method": "POST", "path": "/users",
     "body": {"name": "Email Ruim", "email": "invalido", "password": "1234"}, "expect": 400},
    {"label": "Atualizar usuário", "method": "PUT", "path": "/users/{user_id}",
     "body": {"name": "Smoke User Editado"}, "expect": 200},
    {"label": "Listar tasks do usuário", "method": "GET", "path": "/users/1/tasks", "expect": 200},
    {"label": "Login válido", "method": "POST", "path": "/login",
     "body": {"email": "joao@email.com", "password": "1234"}, "expect": 200},
    {"label": "Login com senha errada", "method": "POST", "path": "/login",
     "body": {"email": "joao@email.com", "password": "errada"}, "expect": 401},

    {"label": "Relatório geral", "method": "GET", "path": "/reports/summary", "expect": 200},
    {"label": "Relatório do usuário", "method": "GET", "path": "/reports/user/1", "expect": 200},
    {"label": "Relatório de usuário inexistente", "method": "GET", "path": "/reports/user/9999", "expect": 404},

    {"label": "Listar categorias", "method": "GET", "path": "/categories", "expect": 200},
    {"label": "Criar categoria", "method": "POST", "path": "/categories",
     "body": {"name": "Smoke", "description": "Categoria do smoke test", "color": "#123456"},
     "expect": 201, "save": {"category_id": "id"}},
    {"label": "Criar categoria sem dados", "method": "POST", "path": "/categories",
     "body": {}, "expect": 400},
    {"label": "Atualizar categoria", "method": "PUT", "path": "/categories/{category_id}",
     "body": {"name": "Smoke Editada"}, "expect": 200},

    {"label": "Deletar categoria criada", "method": "DELETE", "path": "/categories/{category_id}", "expect": 200},
    {"label": "Deletar task criada", "method": "DELETE", "path": "/tasks/{task_id}", "expect": 200},
    {"label": "Deletar task inexistente", "method": "DELETE", "path": "/tasks/9999", "expect": 404},
    {"label": "Deletar usuário criado", "method": "DELETE", "path": "/users/{user_id}", "expect": 200}
  ]
}
