{
  "name": "code-smells-project",
  "description": "API de e-commerce (Python/Flask). Banco SQLite recriado a cada execução.",
  "cwd": "code-smells-project",
  "port": 5001,
  "setup": ["rm -f loja.db"],
  "start": ".venv/bin/flask --app app run --port {port}",
  "ready_path": "/",
  "requests": [
    {"label": "Index", "method": "GET", "path": "/", "expect": 200},
    {"label": "Health check", "method": "GET", "path": "/health", "expect": 200},

    {"label": "Listar produtos", "method": "GET", "path": "/produtos", "expect": 200},
    {"label": "Buscar produtos por termo", "method": "GET", "path": "/produtos/busca?q=gamer", "expect": 200},
    {"label": "Buscar produtos por categoria e faixa de preço", "method": "GET", "path": "/produtos/busca?categoria=informatica&preco_min=100&preco_max=500", "expect": 200},
    {"label": "Buscar produto existente", "method": "GET", "path": "/produtos/1", "expect": 200},
    {"label": "Buscar produto inexistente", "method": "GET", "path": "/produtos/9999", "expect": 404},
    {"label": "Criar produto", "method": "POST", "path": "/produtos",
     "body": {"nome": "Produto Smoke", "descricao": "Criado pelo smoke test", "preco": 10.5, "estoque": 5, "categoria": "geral"},
     "expect": 201, "save": {"produto_id": "dados.id"}},
    {"label": "Criar produto sem nome", "method": "POST", "path": "/produtos",
     "body": {"preco": 10, "estoque": 1}, "expect": 400},
    {"label": "Criar produto com categoria inválida", "method": "POST", "path": "/produtos",
     "body": {"nome": "Produto X", "preco": 10, "estoque": 1, "categoria": "invalida"}, "expect": 400},
    {"label": "Atualizar produto", "method": "PUT", "path": "/produtos/{produto_id}",
     "body": {"nome": "Produto Smoke Editado", "descricao": "Editado", "preco": 12, "estoque": 3, "categoria": "geral"}, "expect": 200},
    {"label": "Atualizar produto inexistente", "method": "PUT", "path": "/produtos/9999",
     "body": {"nome": "Nada", "preco": 1, "estoque": 1}, "expect": 404},

    {"label": "Listar usuários", "method": "GET", "path": "/usuarios", "expect": 200},
    {"label": "Buscar usuário existente", "method": "GET", "path": "/usuarios/1", "expect": 200},
    {"label": "Buscar usuário inexistente", "method": "GET", "path": "/usuarios/9999", "expect": 404},
    {"label": "Criar usuário", "method": "POST", "path": "/usuarios",
     "body": {"nome": "Smoke User", "email": "smoke@teste.com", "senha": "smoke123"},
     "expect": 201, "save": {"usuario_id": "dados.id"}},
    {"label": "Criar usuário sem senha", "method": "POST", "path": "/usuarios",
     "body": {"nome": "Sem Senha", "email": "sem@senha.com"}, "expect": 400},
    {"label": "Login válido", "method": "POST", "path": "/login",
     "body": {"email": "admin@loja.com", "senha": "admin123"}, "expect": 200},
    {"label": "Login com senha errada", "method": "POST", "path": "/login",
     "body": {"email": "admin@loja.com", "senha": "errada"}, "expect": 401},

    {"label": "Criar pedido", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": 2}, {"produto_id": 2, "quantidade": 1}]},
     "expect": 201, "save": {"pedido_id": "dados.pedido_id"}},
    {"label": "Criar pedido sem estoque", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": [{"produto_id": 1, "quantidade": 999}]}, "expect": 400},
    {"label": "Criar pedido sem itens", "method": "POST", "path": "/pedidos",
     "body": {"usuario_id": 2, "itens": []}, "expect": 400},
    {"label": "Listar todos os pedidos", "method": "GET", "path": "/pedidos", "expect": 200},
    {"label": "Listar pedidos do usuário", "method": "GET", "path": "/pedidos/usuario/2", "expect": 200},
    {"label": "Aprovar pedido", "method": "PUT", "path": "/pedidos/{pedido_id}/status",
     "body": {"status": "aprovado"}, "expect": 200},
    {"label": "Status de pedido inválido", "method": "PUT", "path": "/pedidos/{pedido_id}/status",
     "body": {"status": "invalido"}, "expect": 400},
    {"label": "Relatório de vendas", "method": "GET", "path": "/relatorios/vendas", "expect": 200},

    {"label": "Deletar produto criado", "method": "DELETE", "path": "/produtos/{produto_id}", "expect": 200},
    {"label": "Deletar produto inexistente", "method": "DELETE", "path": "/produtos/9999", "expect": 404},

    {"label": "Admin: executar query de leitura", "method": "POST", "path": "/admin/query",
     "body": {"sql": "SELECT COUNT(*) AS total FROM produtos"}, "expect": 200},
    {"label": "Admin: resetar banco (destrutivo, por último)", "method": "POST", "path": "/admin/reset-db", "expect": 200}
  ]
}
